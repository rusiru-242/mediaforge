# EditorConfig — https://editorconfig.org
# MediaForge Monorepo

root = true

# -------------------------
# Global defaults
# -------------------------
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true

# -------------------------
# Java
# -------------------------
[*.java]
indent_size = 4

# -------------------------
# Kotlin
# -------------------------
[*.kt]
indent_size = 4

# -------------------------
# Dart / Flutter
# -------------------------
[*.dart]
indent_size = 2

# -------------------------
# XML / Maven POM
# -------------------------
[*.xml]
indent_size = 4

[pom.xml]
indent_size = 4

# -------------------------
# JSON
# -------------------------
[*.json]
indent_size = 2

# -------------------------
# YAML
# -------------------------
[*.{yml,yaml}]
indent_size = 2

# -------------------------
# Markdown
# -------------------------
[*.md]
trim_trailing_whitespace = false
indent_size = 2

# -------------------------
# SQL
# -------------------------
[*.sql]
indent_size = 2

# -------------------------
# Shell scripts
# -------------------------
[*.{sh,bash}]
indent_size = 2
end_of_line = lf

# -------------------------
# PowerShell
# -------------------------
[*.{ps1,psm1,psd1}]
indent_size = 4

# -------------------------
# Makefile
# -------------------------
[Makefile]
indent_style = tab

