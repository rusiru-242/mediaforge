# Safe examples only. Docker Compose reads .env; plain java does NOT load .env.
# Set actual values in your cloud dashboard or process environment.
PORT=8081
SPRING_PROFILES_ACTIVE=prod
# Exact public HTTPS origins, comma-separated. Empty denies browser CORS.
CORS_ALLOWED_ORIGINS=
# Browser-reachable HTTPS API base; set before Next.js build (no trailing slash).
NEXT_PUBLIC_API_BASE_URL=

# Docker defaults; for plain local Java use writable local paths / installed tools.
STORAGE_LOCAL_PATH=/app/storage
UPLOAD_TEMP_PATH=/app/tmp
STORAGE_RETENTION_HOURS=6
STORAGE_MINIMUM_FREE_BYTES=1073741824
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
YTDLP_PATH=/opt/extractor/bin/yt-dlp
YTDLP_JS_RUNTIMES=node:/usr/local/bin/node
YTDLP_TIMEOUT_SECONDS=60
DOWNLOAD_TIMEOUT_SECONDS=3600
DOWNLOAD_MAX_FILE_SIZE=524288000
DOWNLOAD_CONNECT_TIMEOUT_MS=10000
DOWNLOAD_READ_TIMEOUT_MS=30000
DOWNLOAD_MAX_REDIRECTS=5
DOWNLOAD_WORKERS=1
DOWNLOAD_QUEUE_CAPACITY=20
METADATA_CONCURRENCY=1
CONVERTER_MAX_FILE_SIZE=524288000
CONVERTER_TIMEOUT_SECONDS=600
CONVERTER_MAX_CONCURRENT_JOBS=1
CONVERTER_QUEUE_CAPACITY=20
FFMPEG_THREADS=2
UPLOAD_MAX_FILE_SIZE=500MB
UPLOAD_MAX_REQUEST_SIZE=510MB
RATE_LIMIT_RPM=60
HTTP_MAX_THREADS=40
HTTP_MAX_CONNECTIONS=200
HTTP_ACCEPT_COUNT=50
# NONE is safe by default. FRAMEWORK requires trusted, sanitizing ingress.
FORWARD_HEADERS_STRATEGY=NONE
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=50 -XX:+ExitOnOutOfMemoryError -Djava.io.tmpdir=/app/tmp
COMPOSE_PROJECT_NAME=mediaforge
# Android build-time option (not automatically read by Flutter from this file):
# --dart-define=MEDIAFORGE_ONLINE_API_BASE=https://YOUR-API-HOST/api/v1
