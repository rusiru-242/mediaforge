# =============================================================================
# MediaForge — Comprehensive .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# Operating System
# -----------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encdata
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# -----------------------------------------------------------------------------
# Secrets & Environment
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.cer
*.crt
secrets/
credentials/

# -----------------------------------------------------------------------------
# IDEs & Editors
# -----------------------------------------------------------------------------
# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# VS Code
.vscode/
!.vscode/extensions.json

# Eclipse
.classpath
.project
.settings/
*.launch

# NetBeans
nbproject/
nbbuild/
dist/
nbdist/

# Vim
*.swp
*.swo
*~

# Emacs
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc

# Sublime Text
*.tmlanguage.cache
*.tmPreferences.cache
*.stTheme.cache
*.sublime-workspace
*.sublime-project

# -----------------------------------------------------------------------------
# Java / Spring Boot (backend/)
# -----------------------------------------------------------------------------
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
backend/.gradle/
backend/build/
backend/out/
backend/gradle-wrapper.jar
*.class
*.jar
*.war
*.ear
*.nar
!**/src/main/resources/static/
hs_err_pid*
replay_pid*

# -----------------------------------------------------------------------------
