web/node_modules/
web/.next/
web/out/
web/dist/
web/build/
web/.pnp
web/.pnp.js
web/.yarn/cache
web/.yarn/unplugged
web/.yarn/build-state.yml
web/.yarn/install-state.gz
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm
.eslintcache
.stylelintcache
.cache/
.parcel-cache

