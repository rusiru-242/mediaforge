*.mp4
*.webm
*.mkv
*.avi
*.mov
*.flv
*.wmv
*.m4v
*.mp3
*.wav
*.flac
*.aac
*.ogg
*.opus
*.m4a
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.tiff
*.tif
*.webp
*.ico
*.svg
!docs/diagrams/*.svg
*.pdf

# Temporary upload/download/conversion directories
uploads/
downloads/
converted/
temp/
tmp/
processing/
output/

# -----------------------------------------------------------------------------
